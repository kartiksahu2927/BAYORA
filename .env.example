# Default mode: no model runtime required.
LLM_PROVIDER=fixture
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=10
BAYORA_WORKER_TIMEOUT_SECONDS=15
BAYORA_BOOTSTRAP_RED_PASSWORD=
BAYORA_BOOTSTRAP_BLUE_PASSWORD=
BAYORA_BOOTSTRAP_ADMIN_PASSWORD=
BAYORA_BOOTSTRAP_AUDITOR_PASSWORD=
BAYORA_SESSION_COOKIE_SECURE=0

# Optional TinyFish security intelligence integration. Leave blank to keep
# the application running with the integration reported as NOT CONFIGURED.
TINYFISH_API_KEY=
TINYFISH_BASE_URL=https://agent.tinyfish.ai/v1
TINYFISH_TIMEOUT_SECONDS=30
TINYFISH_POLL_INTERVAL_SECONDS=2
TINYFISH_MAX_DURATION_SECONDS=120
BAYORA_INTELLIGENCE_MAX_RESULTS=20
# Optional JSON object of approved category -> exact HTTPS source URL arrays.
# BAYORA_INTELLIGENCE_ALLOWED_SOURCES={"nvd":["https://nvd.nist.gov/vuln/search"]}

# Remote mode example:
# LLM_PROVIDER=openai_compatible
# LLM_BASE_URL=https://your-model-gateway.example/v1
# LLM_API_KEY=replace-me
# LLM_MODEL=your-model
# BAYORA_WORKER_TIMEOUT_SECONDS=15

# Optional local Ollama mode:
# LLM_PROVIDER=ollama
# LLM_BASE_URL=http://ollama:11434
# LLM_MODEL=your-local-model

# Explicit failure-path mode (the normal default remains fixture):
# LLM_PROVIDER=unconfigured
